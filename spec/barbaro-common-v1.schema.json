{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barbaro.local/schema/barbaro-common-v1.schema.json",
  "title": "Barbaro v1 common definitions",
  "$defs": {
    "provider": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "typedId": {
      "type": "string",
      "pattern": "^(ses|turn|act|ev|lease)_[0-9a-f]{32}$"
    },
    "workstreamId": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{32}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object",
      "required": ["text", "fidelity", "truncated", "redactions"],
      "properties": {
        "text": { "type": "string" },
        "fidelity": {
          "enum": ["verbatim", "normalized", "excerpt", "redacted"]
        },
        "truncated": { "type": "boolean" },
        "original_utf8_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "count"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "truncated": { "const": true } },
            "required": ["truncated"]
          },
          "then": { "required": ["original_utf8_bytes"] }
        }
      ],
      "additionalProperties": false
    },
    "outcome": {
      "enum": [
        "success",
        "partial",
        "blocked",
        "failed",
        "cancelled",
        "abandoned",
        "unknown"
      ]
    },
    "actionOutcome": {
      "enum": ["success", "failed", "denied", "interrupted", "unknown"]
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "sourceRef": {
      "type": "object",
      "required": ["trace_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "trace_path": { "type": "string", "minLength": 1 },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "native_record_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "required": ["line_end"] },
          "then": { "required": ["line_start"] }
        }
      ],
      "additionalProperties": false
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": { "type": "object" }
    }
  }
}
