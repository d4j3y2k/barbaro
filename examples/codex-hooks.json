{
  "_comment": [
    "Barbaro activation template for Codex. Merge these entries into",
    "~/.codex/hooks.json (or one project .codex/hooks.json) and replace",
    "BARBARO_BIN with the absolute path printed by `command -v barbaro`.",
    "Keep the surrounding single quotes: the shell then treats the path",
    "literally, spaces, $ and backticks included. Escape a backslash or a",
    "double quote in the path as JSON requires. A path that itself contains a",
    "single quote is not supported by this template.",
    "Choose one scope only; matching user and project hooks both run.",
    "The hooks remain dormant until a session explicitly invokes $barbaro.",
    "Add .barbaro/ to Git ignore rules before use; derived records may",
    "contain sensitive prompt, response, tool, path, and failure details."
  ],
  "description": "Dormant Barbaro hooks. A session publishes only after the user explicitly invokes the `$barbaro` skill.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          },
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook-ingest",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          },
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook-ingest",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 30,
            "async": false
          },
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook-ingest",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook",
            "timeout": 3,
            "async": false
          },
          {
            "type": "command",
            "command": "'BARBARO_BIN' codex hook-ingest",
            "timeout": 3,
            "async": false
          }
        ]
      }
    ]
  }
}
